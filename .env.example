NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Optional: geheimer Schlüssel für iCal-Links mit Gastnamen (…/api/ical?key=…)
ICAL_KEY=

# Optional: Geheimwert für den anonymen Geräte-Hash im Spam-Schutz
SPAM_SALT=

# Optional: Geheimwert zum Signieren der Anmelde-Tokens
SESSION_SECRET=

# Optional: Resend API-Key für Bestätigungsmails (https://resend.com)
RESEND_API_KEY=
# Absenderadresse (muss in Resend verifiziert sein)
RESEND_FROM=Rikscha Merten <no-reply@rikscha-merten.de>
